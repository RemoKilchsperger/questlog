# Online-Funktionen (Login, Cloud-Spielstand, Rangliste).
# Kopieren nach ".env.local" und mit den Werten aus Supabase füllen:
# Dashboard → Project Settings → API → "Project URL" und "anon public" Key.
# Ohne diese Werte läuft die App wie bisher rein lokal.
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
